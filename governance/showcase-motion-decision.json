{
  "schemaVersion": "motif-library-showcase-motion-decision/1.1",
  "decisionId": "motif-library-modal-showcase-motion-v2",
  "artifactId": "landometer-motif-library-web-v1",
  "artifactRelease": "1.2.0",
  "status": "owner_selected_for_named_artifact",
  "recordedOn": "2026-09-06",
  "authority": {
    "source": "current user request plus carried-forward explicit request for reveal autoplay and auto replay",
    "scope": "Preview dialog in this motif-library website only",
    "intent": "Let dev, design, product, and sales viewers perceive the complete authored animations without manual timeline control."
  },
  "classification": "component_local_instructional_showcase",
  "showcaseBehavior": {
    "trigger": "user_opened_reveal",
    "initialPlayback": "immediate_autoplay",
    "landometer": {
      "presentation": "full_and_quiet_simultaneous_side_by_side",
      "defaultReplayIntervalMs": 3000,
      "logo": {
        "fullAuthoredEndMs": 2870,
        "quietAuthoredEndMs": 3360,
        "settleAtMs": 3400,
        "replayIntervalMs": 6000,
        "finalStateHoldMs": 2600,
        "fullHostInk": "blue",
        "wedge": "token-derived; Chrome sRGB #1F87CE",
        "reference": "owner-supplied set-3 example HTML"
      }
    },
    "ijjiAnimatedIdentity": {
      "full": { "durationMs": 9000, "loopGapMs": 400, "surface": "brand-blue", "bounce": "playful" },
      "mark": { "durationMs": 6400, "loopGapMs": 400, "notagline": true, "bounce": "extra" },
      "reference": "owner-supplied ijji example HTML"
    },
    "runConditions": ["dialog_is_open", "document_is_visible", "prefers_reduced_motion_is_not_reduce", "viewer_has_not_manually_paused"],
    "controls": {
      "pause": "Pause auto-replay and leave the selected preview at its complete final state.",
      "replayNow": "Restart the selected preview and resume auto-replay."
    },
    "cleanup": ["stop_on_dialog_close", "stop_when_document_hidden", "stop_on_pagehide"]
  },
  "accessibility": {
    "cycleAnnouncements": "none",
    "timer": "excluded_from_live_announcements",
    "reducedMotion": "show_complete_final_state_without_replay",
    "viewerControl": "pause_and_replay_now_controls_when_motion_is_allowed"
  },
  "productionBoundary": {
    "landometer": "finite_once_then_hold_final",
    "ijjiAnimatedIdentity": "finite_once_on_visibility_then_hold_final",
    "ijjiPendingMotifs": "state_bound_only",
    "implementationSnippets": "no_loop_attribute",
    "normativeDesignSystemChange": false,
    "portableLoopPermission": false
  }
}
